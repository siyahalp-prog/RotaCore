# Rota Core environment variables
# Copy this file to .env and fill in real values. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=3000
API_HOST=0.0.0.0

# ─── Security ──────────────────────────────────────────────────────────────────
# Bearer token protecting /admin/* routes.
# REQUIRED in production. Leave blank in local dev (admin routes unprotected).
# Generate: openssl rand -hex 32
ADMIN_TOKEN=

# Allowed CORS origin for /track and /track.js (browser-facing endpoints).
# Set to your product domain in production, e.g. https://rotaglobal.com
# Defaults to * (all origins) when unset — OK for local dev only.
CORS_ORIGIN=

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/rota_core

# ─── Redis (optional, future event adapter / cache) ───────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Email (SMTP provider placeholder) ────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@rota.app

# ─── Alerts ───────────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ─── Analytics ────────────────────────────────────────────────────────────────
ANALYTICS_ALLOWED_ORIGINS=http://localhost:3000
